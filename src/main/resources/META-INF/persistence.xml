<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="LibroPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Clase entidad del modelo -->
        <class>com.example.proyectohibernateg3.model.Libro</class>

        <properties>
            <!-- Conexión a PostgreSQL (ajusta nombre_bd, usuario y password) -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/tu_base_datos"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>


            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Muestra las sentencias SQL ejecutadas en la consola -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Gestión del esquema: "validate" comprueba que las tablas coincidan con el esquema -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- Esquema por defecto según tu CREATE SCHEMA -->
            <property name="hibernate.default_schema" value="catalogos"/>
        </properties>
    </persistence-unit>

</persistence>
